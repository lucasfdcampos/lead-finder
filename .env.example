# ─── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional – Google Custom Search JSON API (100 req/day free) ─────────────
# Setup: https://programmablesearchengine.google.com/ → create engine → copy CX
# Enable "Custom Search API" in Google Cloud Console for the same project.
# This is the RECOMMENDED search backend — most reliable.
GOOGLE_SEARCH_API_KEY=your_google_cloud_api_key_here
GOOGLE_CX=your_programmable_search_engine_cx_here

# ─── Optional – SerpAPI (100 req/month free) ─────────────────────────────────
# Sign up at https://serpapi.com/ to get an API key.
# Used if GOOGLE_SEARCH_API_KEY is not set.
SERPAPI_KEY=your_serpapi_key_here

# ─── Optional – Bing Web Search (RapidAPI) ───────────────────────────────────
# Subscribe to "Bing Web Search API" on https://rapidapi.com/
# Used if neither GOOGLE_SEARCH_API_KEY nor SERPAPI_KEY are set.
BING_API_KEY=your_rapidapi_key_here

# ─── Optional – Foursquare Places API v3 ─────────────────────────────────────
# Get key at https://developer.foursquare.com/ (free tier available)
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# ─── Optional – LocationIQ Geocoder ──────────────────────────────────────────
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
